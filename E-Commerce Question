import java.util.Scanner;
public class main {
	public static void main(String[]args) {
		Scanner sc = new Scanner(System.in);
		int n = sc.nextInt();
		sc.nextLine();
		String[] arr = new String[n];
		for(int i=0;i<n;i++) {
			arr[i]=sc.nextLine();
		}
		  int count=0;
		for(int i=0;i<n;i++) {
			if(arr[i].equals("SUCCESS")){
			count++;
		}
	}
		int count1=0;
		for(int i=0;i<n;i++) {
			if(arr[i].equals("FAILED")){
			count1++;
		}
	}
		System.out.println("Total Request:"+n);
		System.out.println("Successful:"+count);
		System.out.println("Failed:"+count1);
		
		float sp = count * 100/n;
		System.out.println("Success Persentage:"+sp);
		
		
	}
}
